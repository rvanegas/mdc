#!/bin/bash
#
# Indexes every library through mdc's API (SERVER.md, Phase 2), for cron on
# the commons box:
#
#   30 9 * * *  ~/mdc/bin/nightly-index >> ~/.local/state/mdc-nightly.log 2>&1
#
# It goes through the API, with a service token ("*" in users.toml), like
# any other client, never `docker exec`. The token lives outside ~/mdc, which
# bin/deploy mirrors with --delete. A library busy with a run (409) is left
# for the next night.
set -euo pipefail

API=${MDC_API:-http://127.0.0.1:8001}
TOKEN=$(cat "${MDC_NIGHTLY_TOKEN_FILE:-$HOME/.config/mdc/nightly-token}")
AUTH="Authorization: Bearer $TOKEN"

echo "== $(date -u +%Y-%m-%dT%H:%M:%SZ)"
libraries=$(curl -fsS -H "$AUTH" "$API/libraries" \
  | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["libraries"]))')
for lib in $libraries; do
  echo "-- $lib"
  curl -sSN -H "$AUTH" -H "Content-Type: application/json" \
    -d '{"argv": ["index"]}' "$API/libraries/$lib/run" \
    | python3 -c '
import json, sys
event = None
for line in sys.stdin:
    if line.startswith("event: "):
        event = line[7:].strip()
    elif line.startswith("data: ") and event in ("done", "error"):
        print(event, line[6:].strip())
    elif line.startswith("{"):
        print("refused", line.strip())'
done
